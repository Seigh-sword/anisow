<?xml version="1.0" encoding="utf-8"?>
<!-- Grid cell: artwork in a glass-edged card, age chip floating on top. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/grid_spacing">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="180dp"
        app:cardBackgroundColor="@color/color_surface_card"
        app:cardCornerRadius="@dimen/card_radius"
        app:cardElevation="6dp"
        app:strokeColor="@color/glass_stroke"
        app:strokeWidth="@dimen/hairline">

        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_poster"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/ageBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="6dp"
        android:background="@drawable/bg_glass_chip"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp">

        <TextView
            android:id="@+id/age"
            style="@style/TextAppearance.AniLab.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/color_on_surface"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass"
    android:orientation="vertical"
    android:padding="@dimen/section_spacing">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_glass_circle"
            android:contentDescription="@null"
            android:padding="10dp"
            android:src="@drawable/ic_info" />

        <TextView
            android:id="@+id/title"
            style="@style/TextAppearance.AniLab.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/close_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/clear_text_end_icon_content_description"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <TextView
        android:id="@+id/message"
        style="@style/TextAppearance.AniLab.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp" />

    <TextView
        android:id="@+id/actionBtn"
        style="@style/TextAppearance.AniLab.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_gradient_brand"
        android:gravity="center"
        android:paddingVertical="14dp"
        android:textColor="@color/color_on_brand"
        android:visibility="gone" />
</LinearLayout>

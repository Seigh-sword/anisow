<?xml version="1.0" encoding="utf-8"?>
<!-- Window background: the brand gradient at low opacity over the base colour,
     so every screen has depth behind its glass surfaces. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_surface" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="#00000000"
                android:endColor="#26FF00FF"
                android:startColor="#26007BFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>

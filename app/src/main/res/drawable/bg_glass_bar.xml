<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom bar: dark glass with a gradient hairline along the top edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill_dark" />
        </shape>
    </item>
    <item android:height="@dimen/hairline" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#66FF00FF"
                android:startColor="#66007BFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>

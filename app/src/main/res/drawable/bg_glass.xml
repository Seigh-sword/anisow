<?xml version="1.0" encoding="utf-8"?>
<!-- Gradient hairline: a 1dp ring that fades from blue to magenta. Draw it
     behind a glass shape to get the edge light of real glass. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <stroke
        android:width="@dimen/hairline"
        android:color="@color/glass_stroke" />
    <gradient
        android:angle="45"
        android:centerColor="@color/glass_fill_dark"
        android:endColor="#33FF00FF"
        android:startColor="#33007BFF"
        android:type="linear" />
    <corners android:radius="@dimen/glass_radius" />
</shape>

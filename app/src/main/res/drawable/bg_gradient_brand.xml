<?xml version="1.0" encoding="utf-8"?>
<!-- The brand gradient, blue to magenta. Used by buttons, chips and the hero. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:endColor="@color/brand_end"
        android:startColor="@color/brand_start"
        android:type="linear" />
    <corners android:radius="@dimen/glass_radius" />
</shape>

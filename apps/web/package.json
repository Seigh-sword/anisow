{
  "name": "@anispots/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AniSpots for the browser.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "npm run build && node server/proxy.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/**/*.test.ts",
    "start": "node server/proxy.mjs",
    "dev:demo": "VITE_DEMO=1 vite --host 0.0.0.0 --port 5174",
    "build:demo": "VITE_DEMO=1 vite build"
  },
  "dependencies": {
    "@anispots/core": "*",
    "@anispots/design": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  }
}

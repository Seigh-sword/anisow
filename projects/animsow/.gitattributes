# Auto detect text files and perform LF normalization
* text=auto

# Custom for verbose / normal etc
*.java   text diff=java
*.kt     text diff=kotlin
*.kts    text diff=kotlin
*.xml    text diff=xml
*.gradle text diff=groovy
*.properties text
*.md     text
*.json   text

# Binary files - no diff
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.webp binary
*.zip binary
*.jar binary
*.aar binary
*.so binary
*.dex binary
*.apk binary
*.class binary

# Line endings for shell scripts
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

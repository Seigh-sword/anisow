# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output. Anchored where the name is ambiguous: `tools/build/` was a
# source directory until this rule swallowed it, and losing a file to .gitignore
# is silent — `git status` simply does not mention it.
/dist/
/build/
/out/
apps/*/dist/
apps/*/build/
apps/*/out/
*.tsbuildinfo
.expo/
.expo-shared/
web-build/

# Native
*.apk
*.aab
*.ipa
android/
ios/

# Env and secrets
.env
.env.local
.env.*.local
google-services.json
GoogleService-Info.plist

# Logs and OS noise
npm-debug.log*
yarn-error.log*
.DS_Store
*.log

# Probe output
tools/probe/probe-result.json

# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output. Anchored where the name is ambiguous: `tools/build/` was a
# source directory until this rule swallowed it, and losing a file to .gitignore
# is silent — `git status` simply does not mention it.
/dist/
/build/
/out/
apps/*/dist/
apps/*/out/
*.tsbuildinfo
.expo/
.expo-shared/
web-build/

# The desktop app's packaging output.
#
# Its `build/` folder holds the entitlements and the installer script, which
# are source and are tracked. A negation cannot re-include a file inside an
# excluded directory, so the directory itself is un-ignored and the generated
# files inside it are excluded by name.
apps/*/build/
!apps/desktop/build/
apps/desktop/build/*
!apps/desktop/build/entitlements.mac.plist
!apps/desktop/build/installer.nsh
apps/desktop/dist/

# Native
*.apk
*.aab
*.ipa
android/
ios/

# Env and secrets
.env
.env.local
.env.*.local
google-services.json
GoogleService-Info.plist

# Logs and OS noise
npm-debug.log*
yarn-error.log*
.DS_Store
*.log

# Probe output
tools/probe/probe-result.json
